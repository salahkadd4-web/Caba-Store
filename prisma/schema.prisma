generator client {
  provider = "prisma-client-js"
  output          = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  nom            String
  prenom         String
  email          String?         @unique
  telephone      String?         @unique
  motDePasse     String?
  role           Role            @default(CLIENT)
  avatar         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  age            Int?
  genre          Genre?
  wilaya         String?   // code de wilaya ("16"), cf. lib/algeria
  commune        String?
  adresse String?
  cart           Cart?
  favorites      Favorite[]
  orders         Order[]
  resetTokens    ResetToken[]
  vendeurProfile VendeurProfile?
}

model VendeurProfile {
  id              String            @id @default(cuid())
  userId          String            @unique
  statut          VendeurStatut     @default(EN_ATTENTE)
  nomBoutique     String?
  description     String?
  adminNote       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  categories      Category[]
  products        Product[]
  documents       VendeurDocument[]
  abonnement        Abonnement?
  prioriteAffichage Int             @default(4) // = niveau d'abonnement (cf. lib/billing-offers.ts)
  user            User              @relation(fields: [userId], references: [id])
}

model VendeurDocument {
  id          String         @id @default(cuid())
  vendeurId   String
  type        String
  label       String
  description String?
  fichier     String?
  statut      DocumentStatut @default(EN_ATTENTE)
  adminNote   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  vendeur     VendeurProfile @relation(fields: [vendeurId], references: [id])

  @@index([vendeurId])
}

model Category {
  id          String          @id @default(cuid())
  nom         String          @unique
  description String?
  image       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  statut      CategoryStatut  @default(APPROUVEE)
  vendeurId   String?
  vendeur     VendeurProfile? @relation(fields: [vendeurId], references: [id])
  products    Product[]

  @@index([vendeurId])
}

model Product {
  id            String           @id @default(cuid())
  nom           String
  description   String?
  prix          Float
  stock         Int              @default(0)
  images        String[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  categoryId    String
  actif         Boolean          @default(true)
  vendeurId     String?
  prixVariables Json?
  typeOption    String? 
  cartItems     CartItem[]
  favorites     Favorite[]
  orderItems    OrderItem[]
  category      Category         @relation(fields: [categoryId], references: [id])
  vendeur       VendeurProfile?  @relation(fields: [vendeurId], references: [id])
  variants      ProductVariant[]

  @@index([vendeurId])
  @@index([categoryId])
  @@index([actif, createdAt])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  nom        String
  couleur    String?
  stock      Int         @default(0)
  images     String[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  cartItems  CartItem[]
  orderItems OrderItem[]
  options   VariantOption[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model VariantOption {
  id        String         @id @default(cuid())
  variantId String
  valeur    String         // ex: "40", "S", "M", "100ml"
  stock     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([variantId])
}

/// Formule de facturation d'un vendeur (cf. lib/billing-offers.ts).
/// dateDebut / dateFin = cycle mensuel en cours (ancré sur la date d'approbation).
model Abonnement {
  id                   String           @id @default(cuid())
  vendeurId            String           @unique
  mode                 ModeFacturation  @default(COMMISSION)
  niveau               NiveauAbonnement @default(NIVEAU_4)
  statut               StatutAbonnement @default(ACTIF)
  dateDebut            DateTime         @default(now())
  dateFin              DateTime
  periodicite          String?          // forfait : "mensuel" | "semestriel" | "annuel"
  forfaitFin           DateTime?        // fin du forfait en cours
  prochainMode         ModeFacturation? // offre choisie, appliquée au prochain cycle
  prochainNiveau       NiveauAbonnement?
  prochainePeriodicite String?
  avoir                Float            @default(0) // crédit (retours sur commission déjà payée), déduit de la prochaine facture
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  vendeur              VendeurProfile   @relation(fields: [vendeurId], references: [id])
  paiements            Paiement[]
  factures             Facture[]
}

/// Somme due par un vendeur : commission d'un cycle écoulé ou forfait.
/// A_VENIR = forfait pas encore exigible (aucune commande livrée sur sa période).
model Facture {
  id             String           @id @default(cuid())
  abonnementId   String
  type           ModeFacturation
  niveau         NiveauAbonnement
  periodicite    String?
  taux           Float?
  ventesBrutes   Float            @default(0)
  nbCommandes    Int              @default(0)
  montant        Float            // net, après déduction de l'avoir
  avoirDeduit    Float            @default(0)
  periodeDebut   DateTime
  periodeFin     DateTime
  statut         StatutFacture    @default(EN_ATTENTE)
  emiseLe        DateTime?        // date à laquelle elle devient exigible
  echeance       DateTime?        // au-delà, le vendeur est bloqué
  rappelsEnvoyes Int[]            @default([])
  paiementId     String?          @unique
  payeeLe        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  abonnement     Abonnement       @relation(fields: [abonnementId], references: [id])
  paiement       Paiement?        @relation(fields: [paiementId], references: [id])

  @@index([abonnementId])
  @@index([statut, echeance])
}

model Paiement {
  id                String     @id @default(cuid())
  abonnementId      String
  montant           Float
  dateReglement     DateTime   @default(now())
  methode           String     // "virement" | "ccp" | "cash"
  reference         String?
  note              String?
  confirmeParAdmin  Boolean    @default(false)
  createdAt         DateTime   @default(now())
  abonnement        Abonnement @relation(fields: [abonnementId], references: [id])
  facture           Facture?

  @@index([abonnementId])
}

model Cart {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String          @id @default(cuid())
  quantite  Int             @default(1)
  cartId    String
  productId String
  variantId String?
  variantOptionId String?
  cart      Cart            @relation(fields: [cartId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  variantOption   VariantOption?  @relation(fields: [variantOptionId], references: [id])

  @@index([cartId])
  @@index([productId])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])

  @@index([productId])
}

model Order {
  id                    String      @id @default(cuid())
  statut                OrderStatus @default(EN_ATTENTE)
  total                 Float
  adresse               String
  wilaya                String?     // code de wilaya de livraison
  commune               String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  userId                String
  groupeId              String?
  fraisLivraison        Float       @default(700)
  methodeExpedition     String      @default("Livraison standard")
  modePaiement          String      @default("Paiement à la livraison")
  retourDemande         Boolean     @default(false)
  refusLivraisonSignale Boolean     @default(false)
  refusLivraisonRaison  String?
  approbationsVendeurs  Json?
  livreeLe              DateTime?   // passage au statut LIVREE (base de la commission)
  langue                String?     // langue du client à la commande ("fr" | "ar" | "en")
  user                  User        @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  returnRequest         ReturnRequest?
  flowmerceEvenements   FlowmerceStatusEvent[]

  @@index([userId])
  @@index([groupeId])
  @@index([statut, createdAt])
  @@index([livreeLe])
}

model ReturnRequest {
  id                String              @id @default(cuid())
  orderId           String              @unique
  flowmerceClaimId  String?
  status            ReturnRequestStatus @default(PENDING)
  reason            String?
  description       String?
  productId         String?             // produit retourné (null = toute la commande)
  reponses          Json?               // réponses du formulaire de retour
  decideLe          DateTime?           // décision prise par l'admin dans Caba Store
  commissionAjustee Boolean             @default(false) // commission vendeur déjà corrigée
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  order             Order               @relation(fields: [orderId], references: [id])
}

/// File d'envoi des changements de statut vers Flowmerce (cf. lib/flowmerce-statut).
/// Une ligne par changement de statut, écrite dans la transaction du changement.
/// id = X-Flowmerce-Event-Id, réutilisé à chaque essai ; corps = JSON exact signé et envoyé.
model FlowmerceStatusEvent {
  id             String              @id
  orderId        String
  statut         OrderStatus
  corps          String
  etat           FlowmerceEnvoiEtat  @default(EN_ATTENTE)
  tentatives     Int                 @default(0)
  prochainEssai  DateTime            @default(now())
  verrouJusqua   DateTime?           // réservé par un worker jusqu'à cette date
  dernierCode    Int?                // dernier code HTTP reçu
  derniereErreur String?
  livreLe        DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([etat, prochainEssai])
  @@index([orderId, createdAt])
}

enum FlowmerceEnvoiEtat {
  EN_ATTENTE // à envoyer (premier essai ou relance)
  LIVRE      // accepté par Flowmerce (200) ou déjà reçu (409)
  ECHEC      // abandon définitif : 400/401/403 ou tentatives épuisées
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model OrderItem {
  id         String          @id @default(cuid())
  quantite   Int
  prix       Float
  orderId    String
  productId  String
  variantId  String?
  variantNom String?
  variantOptionId     String?
  variantOptionValeur String?
  order      Order           @relation(fields: [orderId], references: [id])
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  variantOption       VariantOption?  @relation(fields: [variantOptionId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model ResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  verified  Boolean  @default(false)
  code      String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OtpToken {
  id          String   @id @default(cuid())
  identifiant String
  token       String
  data        String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([identifiant])
}

enum Role {
  CLIENT
  ADMIN
  VENDEUR
}

enum Genre {
  HOMME
  FEMME
}

enum OrderStatus {
  EN_ATTENTE
  CONFIRMEE
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  ANNULEE
}

enum VendeurStatut {
  EN_ATTENTE
  APPROUVE
  SUSPENDU
  PIECES_REQUISES
}

enum DocumentStatut {
  EN_ATTENTE
  ACCEPTE
  REFUSE
}

enum CategoryStatut {
  EN_ATTENTE
  APPROUVEE
  REFUSEE
}

enum NiveauAbonnement {
  NIVEAU_0
  NIVEAU_1
  NIVEAU_2
  NIVEAU_3
  NIVEAU_4
}

enum ModeFacturation {
  COMMISSION
  FORFAIT
}

enum StatutAbonnement {
  ACTIF
  BLOQUE
}

enum StatutFacture {
  A_VENIR
  EN_ATTENTE
  PAYEE
  ANNULEE
}
