generator client {
  provider = "prisma-client-js"
  output          = "../generated/prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  nom            String
  prenom         String
  email          String?         @unique
  telephone      String?         @unique
  motDePasse     String?
  role           Role            @default(CLIENT)
  avatar         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  age            Int?
  genre          Genre?
  wilaya         String?
  adresse String?
  cart           Cart?
  favorites      Favorite[]
  orders         Order[]
  resetTokens    ResetToken[]
  vendeurProfile VendeurProfile?
}

model VendeurProfile {
  id              String            @id @default(cuid())
  userId          String            @unique
  statut          VendeurStatut     @default(EN_ATTENTE)
  nomBoutique     String?
  description     String?
  adminNote       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  categories      Category[]
  products        Product[]
  documents       VendeurDocument[]
  abonnement        Abonnement?
  prioriteAffichage Int             @default(3)
  user            User              @relation(fields: [userId], references: [id])
}

model VendeurDocument {
  id          String         @id @default(cuid())
  vendeurId   String
  type        String
  label       String
  description String?
  fichier     String?
  statut      DocumentStatut @default(EN_ATTENTE)
  adminNote   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  vendeur     VendeurProfile @relation(fields: [vendeurId], references: [id])
}

model Category {
  id          String          @id @default(cuid())
  nom         String          @unique
  description String?
  image       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  statut      CategoryStatut  @default(APPROUVEE)
  vendeurId   String?
  vendeur     VendeurProfile? @relation(fields: [vendeurId], references: [id])
  products    Product[]
}

model Product {
  id            String           @id @default(cuid())
  nom           String
  description   String?
  prix          Float
  stock         Int              @default(0)
  images        String[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  categoryId    String
  actif         Boolean          @default(true)
  vendeurId     String?
  prixVariables Json?
  typeOption    String? 
  cartItems     CartItem[]
  favorites     Favorite[]
  orderItems    OrderItem[]
  category      Category         @relation(fields: [categoryId], references: [id])
  vendeur       VendeurProfile?  @relation(fields: [vendeurId], references: [id])
  variants      ProductVariant[]
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  nom        String
  couleur    String?
  stock      Int         @default(0)
  images     String[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  cartItems  CartItem[]
  orderItems OrderItem[]
  options   VariantOption[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model VariantOption {
  id        String         @id @default(cuid())
  variantId String
  valeur    String         // ex: "40", "S", "M", "100ml"
  stock     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]
}

model Abonnement {
  id           String           @id @default(cuid())
  vendeurId    String           @unique
  niveau       NiveauAbonnement @default(NIVEAU_3)
  statut       StatutAbonnement @default(GRATUIT)
  dateDebut    DateTime         @default(now())
  dateFin      DateTime
  periodicite  String?          // "mensuel" | "annuel"
  notifsSent   String[]   @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  vendeur      VendeurProfile   @relation(fields: [vendeurId], references: [id])
  paiements    Paiement[]
}

model Paiement {
  id                String     @id @default(cuid())
  abonnementId      String
  montant           Float
  dateReglement     DateTime   @default(now())
  methode           String     // "virement" | "ccp" | "cash"
  reference         String?
  note              String?
  confirmeParAdmin  Boolean    @default(false)
  createdAt         DateTime   @default(now())
  abonnement        Abonnement @relation(fields: [abonnementId], references: [id])
}

model Cart {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String          @id @default(cuid())
  quantite  Int             @default(1)
  cartId    String
  productId String
  variantId String?
  variantOptionId String?
  cart      Cart            @relation(fields: [cartId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  variantOption   VariantOption?  @relation(fields: [variantOptionId], references: [id])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Order {
  id                   String      @id @default(cuid())
  statut               OrderStatus @default(EN_ATTENTE)
  total                Float
  adresse              String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  userId               String
  scan1Done            Boolean     @default(false)
  scan1Result          String?
  scan1ShippingAllowed Boolean     @default(false)
  scan2Done            Boolean     @default(false)
  scan2Result          String?
  fraisLivraison       Float       @default(700)
  methodeExpedition    String      @default("Livraison standard")
  modePaiement         String      @default("Paiement à la livraison")
  retourDemande        Boolean     @default(false)
  approbationsVendeurs  Json?
  user                 User        @relation(fields: [userId], references: [id])
  items                OrderItem[]
  returnRequest        ReturnRequest?
}

model ReturnRequest {
  id                String              @id @default(cuid())
  orderId           String              @unique
  flowmerceClaimId  String?
  status            ReturnRequestStatus @default(PENDING)
  reason            String
  description       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  order             Order               @relation(fields: [orderId], references: [id])
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model OrderItem {
  id         String          @id @default(cuid())
  quantite   Int
  prix       Float
  orderId    String
  productId  String
  variantId  String?
  variantNom String?
  variantOptionId     String?
  variantOptionValeur String?
  order      Order           @relation(fields: [orderId], references: [id])
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  variantOption       VariantOption?  @relation(fields: [variantOptionId], references: [id])
}

model ResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  verified  Boolean  @default(false)
  code      String
  user      User     @relation(fields: [userId], references: [id])
}

model OtpToken {
  id          String   @id @default(cuid())
  identifiant String
  token       String
  data        String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

enum Role {
  CLIENT
  ADMIN
  VENDEUR
}

enum Genre {
  HOMME
  FEMME
}

enum OrderStatus {
  EN_ATTENTE
  CONFIRMEE
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  ANNULEE
}

enum VendeurStatut {
  EN_ATTENTE
  APPROUVE
  SUSPENDU
  PIECES_REQUISES
}

enum DocumentStatut {
  EN_ATTENTE
  ACCEPTE
  REFUSE
}

enum CategoryStatut {
  EN_ATTENTE
  APPROUVEE
  REFUSEE
}

enum NiveauAbonnement {
  NIVEAU_0
  NIVEAU_1
  NIVEAU_2
  NIVEAU_3
}

enum StatutAbonnement {
  GRATUIT
  ACTIF
  EXPIRE
  SUSPENDU
}